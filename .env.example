# Project X — Agentic Script-to-Screen QA Configuration

# Google Cloud Vertex AI (Preferred for Hackathon Production Mode)
GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# Google Gemini API Key (Alternative for Local Developer Mode)
GEMINI_API_KEY=

# ClickHouse Cloud Connection (for cross-generation intelligence & run persistence)
CLICKHOUSE_HOST=
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=default

# Google Cloud Storage (for run artifact archiving)
GCS_BUCKET_NAME=
GCS_PROJECT_ID=

# Server Port (optional, defaults to 3001)
PORT=3001
