# Gemini text prompt testing
GEMINI_API_KEY="your_gemini_api_key"
ALLOW_SERVER_ENV_KEY="true"

# Application URLs
APP_URL="http://localhost:3000"
GENBLAZE_API_BASE_URL="http://127.0.0.1:8000"
PROJECTX_ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,https://projectx.mylife-as-miles.my.id"

# Optional UI setting
NEXT_PUBLIC_ENABLE_KOFI_BUTTON="true"

# Backblaze B2 — server side only
B2_KEY_ID="your_b2_key_id"
B2_APP_KEY="your_b2_application_key"
# Legacy alias accepted by the Python service:
# B2_APPLICATION_KEY="your_b2_application_key"
B2_BUCKET_NAME="projectx-genblaze-media"

# Google image generation through Genblaze
GEMINI_IMAGE_MODEL="gemini-2.5-flash-image"
IMAGEN_MODEL="imagen-3.0-generate-002"

# Optional OpenAI image provider
# OPENAI_API_KEY="your_openai_api_key"
# OPENAI_IMAGE_MODEL="dall-e-3"

# Python pipeline timeout in seconds
GENBLAZE_GENERATION_TIMEOUT="180"
