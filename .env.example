# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ALLOW_SERVER_ENV_KEY: Controls whether end users can utilize the server's GEMINI_API_KEY.
# Set to "false" on deployed/published apps if you want users to supply their own Gemini API key.
# Defaults to "true" when unset or true (recommended for local development & self-hosting).
ALLOW_SERVER_ENV_KEY="true"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# NEXT_PUBLIC_ENABLE_KOFI_BUTTON: Controls whether the Ko-fi support/tipping button is visible in the application header.
# Set to "false" to hide the button entirely. Defaults to "true" when unset.
NEXT_PUBLIC_ENABLE_KOFI_BUTTON="true"

# Backblaze B2 Storage Credentials (For Genblaze & Backblaze B2 Hackathon)
B2_KEY_ID="your_b2_key_id"
B2_APPLICATION_KEY="your_b2_application_key"
B2_BUCKET_NAME="projectx-genblaze-media"

