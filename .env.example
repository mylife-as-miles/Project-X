# Public frontend build setting (ChatGPT Sites). Never put secrets in VITE_*.
VITE_API_BASE_URL=https://PROJECT-X-API-xxxxx.run.app

# Cloud Run backend, using the attached service account and ADC (no key file).
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GCS_BUCKET_NAME=
# Optional override for a bucket in a different project; otherwise uses GOOGLE_CLOUD_PROJECT.
GCS_PROJECT_ID=
CHATGPT_SITE_ORIGIN=https://final-project-site.chatgpt.site
# Optional additional exact HTTPS origins, comma separated. No wildcard.
ALLOWED_ORIGINS=
# Optional trusted public HTTPS media hostnames, comma separated. Prefer gs:// URIs.
MEDIA_ALLOWED_HOSTS=
CLICKHOUSE_HOST=
CLICKHOUSE_USER=default
CLICKHOUSE_DATABASE=default
# Production: map from Secret Manager, never from frontend configuration.
CLICKHOUSE_PASSWORD=
DEMO_MODE=false
PORT=8080

# Optional local development only. Prefer gcloud auth application-default login.
# Do not set GOOGLE_APPLICATION_CREDENTIALS or GEMINI_API_KEY on Cloud Run.
GOOGLE_APPLICATION_CREDENTIALS=
GEMINI_API_KEY=
